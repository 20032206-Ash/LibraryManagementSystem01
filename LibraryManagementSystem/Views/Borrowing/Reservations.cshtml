@model IEnumerable<LibraryManagementSystem.Models.Reservation>

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container-fluid mt-4 mb-5">

    <!-- Header -->
    <div class="p-4 mb-4 text-white"
         style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border-radius: 15px;">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="fw-bold mb-2">📅 My Reservations</h1>
                <p class="mb-0">Total Reservations: <strong>@Model.Count()</strong></p>
            </div>
            <div class="col-md-4 text-end">
                <a asp-controller="Books" asp-action="Index" class="btn btn-light btn-lg">
                    📚 Browse More Books
                </a>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            ⚠️ @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div style="font-size: 3rem;">📚</div>
                                @if (item.Status == LibraryManagementSystem.Models.ReservationStatus.Waiting)
                                {
                                    <span class="badge bg-warning text-dark">⏳ Waiting</span>
                                }
                                else if (item.Status == LibraryManagementSystem.Models.ReservationStatus.ReadyForPickup)
                                {
                                    <span class="badge bg-success">✅ Ready</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">❌ Cancelled</span>
                                }
                            </div>

                            <h5 class="fw-bold">@(item.Book?.Title ?? "Unknown Book")</h5>
                            <p class="text-muted mb-2">
                                <small>✍️ @(item.Book?.Author ?? "N/A")</small>
                            </p>
                            <p class="text-muted mb-3">
                                <small>📅 Reserved: @item.ReservationDate.ToString("dd MMM yyyy")</small>
                            </p>

                            @if (item.Status == LibraryManagementSystem.Models.ReservationStatus.Waiting)
                            {
                                <a href="/Borrowing/CancelReservation?id=@item.Id"
                                       class="btn btn-danger btn-sm w-100"
                                       onclick="return confirm('Cancel this reservation?');">
                                    ❌ Cancel Reservation
                                </a>
                            }
                            else if (item.Status == LibraryManagementSystem.Models.ReservationStatus.ReadyForPickup)
                            {
                                <div class="alert alert-success mb-0 p-2 text-center">
                                    <small>📖 Book is ready! Visit the library to collect.</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center p-5 card border-0 shadow-sm" style="border-radius: 15px;">
            <div style="font-size: 5rem;">📭</div>
            <h3 class="text-muted">No Reservations Yet</h3>
            <p class="text-muted mb-4">You haven't reserved any books yet. Browse our catalog to reserve books!</p>
            <div>
                <a asp-controller="Books" asp-action="Index" class="btn btn-success btn-lg">
                    📚 Browse Books
                </a>
            </div>
        </div>
    }
</div>