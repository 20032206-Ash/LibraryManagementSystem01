@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                <!-- Header -->
                <div class="card-header text-center text-white py-4 border-0"
                     style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <div style="font-size: 4rem;">✏️📖</div>
                    <h2 class="fw-bold mb-0">Edit Book</h2>
                    <p class="mb-0 mt-2" style="opacity: 0.9;">Update book information</p>
                </div>

                <!-- Body -->
                <div class="card-body p-5">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <strong>⚠️ Please fix the errors below:</strong>
                        </div>
                    }

                    <form method="post" asp-action="Edit">
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <!-- Title -->
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold">📖 Book Title <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control form-control-lg" required
                                       style="border-radius: 10px;" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <!-- Author -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">✍️ Author <span class="text-danger">*</span></label>
                                <input asp-for="Author" class="form-control form-control-lg" required
                                       style="border-radius: 10px;" />
                                <span asp-validation-for="Author" class="text-danger"></span>
                            </div>

                            <!-- Genre -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">📂 Genre</label>
                                <select asp-for="Genre" class="form-control form-control-lg" style="border-radius: 10px;">
                                    <option value="">Select a genre...</option>
                                    <option value="Fiction">Fiction</option>
                                    <option value="Non-Fiction">Non-Fiction</option>
                                    <option value="Science">Science</option>
                                    <option value="Technology">Technology</option>
                                    <option value="History">History</option>
                                    <option value="Biography">Biography</option>
                                    <option value="Mystery">Mystery</option>
                                    <option value="Romance">Romance</option>
                                    <option value="Thriller">Thriller</option>
                                    <option value="Fantasy">Fantasy</option>
                                    <option value="Sci-Fi">Sci-Fi</option>
                                    <option value="Self-Help">Self-Help</option>
                                    <option value="Children">Children</option>
                                    <option value="Education">Education</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>

                            <!-- ISBN -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">🔢 ISBN</label>
                                <input asp-for="ISBN" class="form-control form-control-lg" style="border-radius: 10px;" />
                                <span asp-validation-for="ISBN" class="text-danger"></span>
                            </div>

                            <!-- Available Copies -->
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">📚 Available Copies <span class="text-danger">*</span></label>
                                <input asp-for="AvailableCopies" type="number" min="0" max="999"
                                       class="form-control form-control-lg" required
                                       style="border-radius: 10px;" />
                                <span asp-validation-for="AvailableCopies" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-lg text-white fw-bold py-3"
                                    style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
                                border-radius: 10px; border: none;">
                                💾 Update Book
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg" style="border-radius: 10px;">
                                ← Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}