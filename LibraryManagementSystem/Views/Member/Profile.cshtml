@model LibraryManagementSystem.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✅ @TempData["Success"]</div>
            }

            <div class="card shadow-lg border-0" style="border-radius: 20px;">
                <div class="card-header text-white text-center py-4 border-0"
                     style="background: linear-gradient(135deg, #11998e, #38ef7d); border-radius: 20px 20px 0 0;">
                    <div style="font-size: 5rem;">👤</div>
                    <h2 class="fw-bold">My Profile</h2>
                </div>
                <div class="card-body p-5">
                    <form asp-action="UpdateProfile" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Password" />
                        <input type="hidden" asp-for="Role" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">👤 Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-lg" style="border-radius: 10px;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">📧 Email</label>
                            <input value="@Model.Email" class="form-control form-control-lg" disabled style="border-radius: 10px;" />
                            <small class="text-muted">Email cannot be changed</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">📱 Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg" style="border-radius: 10px;" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">🏠 Address</label>
                            <textarea asp-for="Address" class="form-control form-control-lg" rows="3" style="border-radius: 10px;"></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-lg text-white fw-bold py-3"
                                    style="background: linear-gradient(135deg, #11998e, #38ef7d); border-radius: 10px; border: none;">
                                💾 Update Profile
                            </button>
                            <a asp-action="Dashboard" class="btn btn-secondary btn-lg">← Back to Dashboard</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>