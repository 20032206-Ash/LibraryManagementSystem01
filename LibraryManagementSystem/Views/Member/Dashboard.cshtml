@{
    ViewData["Title"] = "Member Dashboard";
    var recentBorrowings = ViewBag.RecentBorrowings as List<LibraryManagementSystem.Models.BorrowingTransaction>;
    var reservations = ViewBag.Reservations as List<LibraryManagementSystem.Models.Reservation>;
    var recommendedBooks = ViewBag.RecommendedBooks as List<LibraryManagementSystem.Models.Book>;
    var member = ViewBag.Member as LibraryManagementSystem.Models.User;
}

<div class="container-fluid mt-4 mb-5">

    <!-- Welcome Banner -->
    <div class="p-4 mb-4 text-white"
         style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); border-radius: 15px; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-2">👋 Welcome, @User.Identity?.Name!</h1>
                <p class="lead mb-0">Discover, borrow, and enjoy books from our library collection.</p>
                @if (member != null)
                {
                    <small>📧 @member.Email | 📱 @(member.PhoneNumber ?? "No phone")</small>
                }
            </div>
            <div class="col-md-4 text-end">
                <div style="font-size: 5rem;">📚</div>
            </div>
        </div>
    </div>

    <!-- Alert for Overdue Books -->
    @if (ViewBag.OverdueBooks > 0)
    {
        <div class="alert alert-danger" style="border-radius: 10px;">
            <strong>⚠️ Attention!</strong> You have <strong>@ViewBag.OverdueBooks</strong> overdue book(s).
            Please return them as soon as possible to avoid fines.
        </div>
    }

    <!-- Alert for Unpaid Fines -->
    @if (ViewBag.UnpaidFinesCount > 0)
    {
        <div class="alert alert-warning" style="border-radius: 10px;">
            <strong>💰 Unpaid Fines:</strong> You have <strong>₹@ViewBag.TotalFines</strong> in unpaid fines.
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <div style="font-size: 3rem;">📖</div>
                    <h2 class="fw-bold text-primary mb-0">@ViewBag.TotalBorrowings</h2>
                    <p class="text-muted mb-2">Total Borrowings</p>
                    <small class="badge bg-light text-dark">@ViewBag.ReturnedBooks returned</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <div style="font-size: 3rem;">🔖</div>
                    <h2 class="fw-bold text-success mb-0">@ViewBag.ActiveBorrowings</h2>
                    <p class="text-muted mb-2">Active Borrowings</p>
                    <small class="badge bg-danger text-white">@ViewBag.OverdueBooks overdue</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <div style="font-size: 3rem;">📅</div>
                    <h2 class="fw-bold text-info mb-0">@ViewBag.ActiveReservations</h2>
                    <p class="text-muted mb-2">Reservations</p>
                    <small class="badge bg-light text-dark">waiting for pickup</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <div style="font-size: 3rem;">💰</div>
                    <h2 class="fw-bold text-danger mb-0">₹@ViewBag.TotalFines</h2>
                    <p class="text-muted mb-2">Total Fines</p>
                    <small class="badge bg-light text-dark">@ViewBag.UnpaidFinesCount unpaid</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <h3 class="fw-bold mb-3">⚡ Quick Actions</h3>
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Books" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100"
                     style="border-radius: 15px; background: linear-gradient(135deg, #11998e, #38ef7d); color: white;">
                    <div class="card-body text-center p-4">
                        <div style="font-size: 2.5rem;">🔍</div>
                        <h5 class="fw-bold mt-2">Browse Books</h5>
                        <small>Explore the catalog</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Borrowing" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100"
                     style="border-radius: 15px; background: linear-gradient(135deg, #667eea, #764ba2); color: white;">
                    <div class="card-body text-center p-4">
                        <div style="font-size: 2.5rem;">🔖</div>
                        <h5 class="fw-bold mt-2">My Borrowings</h5>
                        <small>View active books</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Borrowing" asp-action="Reservations" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100"
                     style="border-radius: 15px; background: linear-gradient(135deg, #f093fb, #f5576c); color: white;">
                    <div class="card-body text-center p-4">
                        <div style="font-size: 2.5rem;">📅</div>
                        <h5 class="fw-bold mt-2">My Reservations</h5>
                        <small>Check reservations</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Member" asp-action="History" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100"
                     style="border-radius: 15px; background: linear-gradient(135deg, #4facfe, #00f2fe); color: white;">
                    <div class="card-body text-center p-4">
                        <div style="font-size: 2.5rem;">📜</div>
                        <h5 class="fw-bold mt-2">History</h5>
                        <small>View borrowing history</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Current Borrowings & Reservations -->
    <div class="row g-4 mb-4">
        
        <!-- Current Borrowings -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header bg-white border-0 py-3" style="border-radius: 15px 15px 0 0;">
                    <h4 class="fw-bold mb-0">📖 Recent Borrowings</h4>
                </div>
                <div class="card-body p-0">
                    @if (recentBorrowings != null && recentBorrowings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Book</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var borrowing in recentBorrowings)
                                    {
                                        <tr>
                                            <td><strong>@(borrowing.Book?.Title ?? "N/A")</strong></td>
                                            <td><small>@borrowing.DueDate.ToString("dd MMM yyyy")</small></td>
                                            <td>
                                                @if (borrowing.Status == LibraryManagementSystem.Models.BorrowingStatus.Active)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else if (borrowing.Status == LibraryManagementSystem.Models.BorrowingStatus.Returned)
                                                {
                                                    <span class="badge bg-secondary">Returned</span>
                                                }
                                                else if (borrowing.Status == LibraryManagementSystem.Models.BorrowingStatus.Overdue)
                                                {
                                                    <span class="badge bg-danger">Overdue</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">@borrowing.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4 text-muted">
                            <div style="font-size: 3rem;">📭</div>
                            <p class="mb-2">No borrowings yet</p>
                            <a asp-controller="Books" asp-action="Index" class="btn btn-success btn-sm">Browse Books</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Active Reservations -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header bg-white border-0 py-3" style="border-radius: 15px 15px 0 0;">
                    <h4 class="fw-bold mb-0">📅 My Reservations</h4>
                </div>
                <div class="card-body p-0">
                    @if (reservations != null && reservations.Any())
                    {
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Book</th>
                                        <th>Reserved On</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reservation in reservations)
                                    {
                                        <tr>
                                            <td><strong>@(reservation.Book?.Title ?? "N/A")</strong></td>
                                            <td><small>@reservation.ReservationDate.ToString("dd MMM yyyy")</small></td>
                                            <td>
                                                @if (reservation.Status == LibraryManagementSystem.Models.ReservationStatus.Waiting)
                                                {
                                                    <span class="badge bg-warning text-dark">Waiting</span>
                                                }
                                                else if (reservation.Status == LibraryManagementSystem.Models.ReservationStatus.ReadyForPickup)
                                                {
                                                    <span class="badge bg-success">Ready</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Cancelled</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4 text-muted">
                            <div style="font-size: 3rem;">📋</div>
                            <p class="mb-0">No active reservations</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recommended Books -->
    <h3 class="fw-bold mb-3">✨ Recommended Books</h3>
    <div class="row g-4">
        @if (recommendedBooks != null && recommendedBooks.Any())
        {
            @foreach (var book in recommendedBooks)
            {
                <div class="col-md-3 col-sm-6">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                        <div class="card-body text-center p-4">
                            <div style="font-size: 4rem;">📕</div>
                            <h5 class="fw-bold mt-2">@book.Title</h5>
                            <p class="text-muted mb-2"><small>by @book.Author</small></p>
                            <span class="badge bg-success mb-2">@book.AvailableCopies available</span>
                            <br />
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                               class="btn btn-outline-success btn-sm mt-2">View Details</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted p-4">
                <p>No books available at the moment.</p>
            </div>
        }
    </div>

</div>