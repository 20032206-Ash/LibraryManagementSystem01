@{
    ViewData["Title"] = "Librarian Dashboard";
    var recentBorrowings = ViewBag.RecentBorrowings as List<LibraryManagementSystem.Models.BorrowingTransaction>;
    var recentMembers = ViewBag.RecentMembers as List<LibraryManagementSystem.Models.User>;
}

<div class="container-fluid mt-4 mb-5">
    
    <!-- Welcome Header -->
    <div class="p-4 mb-4 text-white"
         style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 15px; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-2">👨‍💼 Librarian Dashboard</h1>
                <p class="lead mb-0">Welcome back, @User.Identity?.Name! Manage your library efficiently.</p>
            </div>
            <div class="col-md-4 text-end">
                <div style="font-size: 5rem;">📊</div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards Row 1 -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <div style="font-size: 3rem;">📚</div>
                    <h2 class="fw-bold text-primary mb-0">@ViewBag.TotalBooks</h2>
                    <p class="text-muted mb-2">Total Books</p>
                    <small class="badge bg-light text-dark">@ViewBag.AvailableCopies available copies</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <div style="font-size: 3rem;">👥</div>
                    <h2 class="fw-bold text-success mb-0">@ViewBag.TotalMembers</h2>
                    <p class="text-muted mb-2">Total Members</p>
                    <small class="badge bg-light text-dark">@ViewBag.TotalLibrarians librarians</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <div style="font-size: 3rem;">🔖</div>
                    <h2 class="fw-bold text-warning mb-0">@ViewBag.ActiveBorrowings</h2>
                    <p class="text-muted mb-2">Active Borrowings</p>
                    <small class="badge bg-danger text-white">@ViewBag.OverdueBooks overdue</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <div style="font-size: 3rem;">📅</div>
                    <h2 class="fw-bold text-info mb-0">@ViewBag.PendingReservations</h2>
                    <p class="text-muted mb-2">Reservations</p>
                    <small class="badge bg-light text-dark">₹@ViewBag.TotalFines unpaid fines</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <h3 class="fw-bold mb-3">⚡ Quick Actions</h3>
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Books" asp-action="Create" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100"
                     style="border-radius: 15px; background: linear-gradient(135deg, #667eea, #764ba2); color: white;">
                    <div class="card-body text-center p-4">
                        <div style="font-size: 2.5rem;">➕</div>
                        <h5 class="fw-bold mt-2">Add New Book</h5>
                        <small>Add books to the library</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Books" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100"
                     style="border-radius: 15px; background: linear-gradient(135deg, #11998e, #38ef7d); color: white;">
                    <div class="card-body text-center p-4">
                        <div style="font-size: 2.5rem;">📖</div>
                        <h5 class="fw-bold mt-2">Manage Books</h5>
                        <small>View, edit, delete books</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Librarian" asp-action="Members" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100"
                     style="border-radius: 15px; background: linear-gradient(135deg, #f093fb, #f5576c); color: white;">
                    <div class="card-body text-center p-4">
                        <div style="font-size: 2.5rem;">👥</div>
                        <h5 class="fw-bold mt-2">Manage Members</h5>
                        <small>View all library members</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-controller="Borrowing" asp-action="Manage" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100"
                     style="border-radius: 15px; background: linear-gradient(135deg, #4facfe, #00f2fe); color: white;">
                    <div class="card-body text-center p-4">
                        <div style="font-size: 2.5rem;">⚙️</div>
                        <h5 class="fw-bold mt-2">Manage Borrowings</h5>
                        <small>Track all transactions</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Recent Activity Section -->
    <div class="row g-4">
        
        <!-- Recent Borrowings -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header bg-white border-0 py-3" style="border-radius: 15px 15px 0 0;">
                    <h4 class="fw-bold mb-0">📖 Recent Borrowings</h4>
                </div>
                <div class="card-body p-0">
                    @if (recentBorrowings != null && recentBorrowings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Book</th>
                                        <th>Member ID</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var borrowing in recentBorrowings)
                                    {
                                        <tr>
                                            <td>@(borrowing.Book?.Title ?? "N/A")</td>
                                            <td><small>@borrowing.MemberId</small></td>
                                            <td><small>@borrowing.BorrowDate.ToString("dd MMM")</small></td>
                                            <td>
                                                @if (borrowing.Status == LibraryManagementSystem.Models.BorrowingStatus.Active)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else if (borrowing.Status == LibraryManagementSystem.Models.BorrowingStatus.Returned)
                                                {
                                                    <span class="badge bg-secondary">Returned</span>
                                                }
                                                else if (borrowing.Status == LibraryManagementSystem.Models.BorrowingStatus.Overdue)
                                                {
                                                    <span class="badge bg-danger">Overdue</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">@borrowing.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4 text-muted">
                            <div style="font-size: 3rem;">📭</div>
                            <p class="mb-0">No recent borrowings</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Members -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header bg-white border-0 py-3" style="border-radius: 15px 15px 0 0;">
                    <h4 class="fw-bold mb-0">👥 Recent Members</h4>
                </div>
                <div class="card-body p-0">
                    @if (recentMembers != null && recentMembers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Joined</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in recentMembers)
                                    {
                                        <tr>
                                            <td>@member.FullName</td>
                                            <td><small>@member.Email</small></td>
                                            <td><small>@member.RegisteredDate.ToString("dd MMM")</small></td>
                                            <td>
                                                @if (member.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4 text-muted">
                            <div style="font-size: 3rem;">👤</div>
                            <p class="mb-0">No members registered yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>